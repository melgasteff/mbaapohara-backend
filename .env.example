# Copiar a .env y completar. .env no se sube al repositorio.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=
DB_NAME=mbaapohara
# true en las bases administradas (Neon): conexión cifrada y con el certificado verificado
DB_SSL=false

NODE_ENV=development
PORT=3000

# Orígenes permitidos por CORS, separados por comas. Obligatoria: sin ella la API no arranca.
CORS_ORIGINS=http://localhost:4200

# Proxies de confianza delante de la API: 0 en local. En el despliegue se mide (docs/despliegue.md, paso 5).
TRUST_PROXY_HOPS=0

# Secreto para firmar los tokens (al menos 32 caracteres). Generar con: openssl rand -base64 48
JWT_SECRET=
# Vigencia del token de acceso (s, m, h o d)
JWT_EXPIRES_IN=2h

# Moderación (tarea 2.3). La clave se crea en la consola del proveedor de la API. Sin clave, toda reseña va a revisión humana.
ANTHROPIC_API_KEY=
MODERATION_MODEL=claude-haiku-5-5
# Tope de gasto mensual en USD: al alcanzarlo, todo va a revisión humana hasta el mes siguiente.
MODERATION_MONTHLY_BUDGET_USD=5
MODERATION_TIMEOUT_MS=10000
