# Copiar a .env.test para las pruebas e2e (npm run test:e2e). .env.test no se sube al repositorio.
# La base DEBE terminar en «_test»: las pruebas la crean si no existe y borran su esquema en cada corrida.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=
DB_NAME=mbaapohara_test

NODE_ENV=test
PORT=3001
CORS_ORIGINS=http://localhost:4200
# Solo para las pruebas; generar con: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=2h
